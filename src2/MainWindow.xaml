<Window x:Class="TempNotes2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="随记" Height="760" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#060606"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6,8,3,6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 标题栏功能按钮 -->
        <Style x:Key="TBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窗口控制按钮 -->
        <Style x:Key="WBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <!-- 36 = 标题栏 38 减去 RootBorder 上下各 1px 边框。填 38 会溢出到边框里，
                 视觉上按钮比左侧内容低 1px，"看起来不居中"就是这条。 -->
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WBtnClose" TargetType="Button" BasedOn="{StaticResource WBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C4433C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="#AFC0B8"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#060606" BorderBrush="#1AFFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏（WPF 原生，WindowChrome 负责拖动/双击最大化） ===== -->
            <Grid Grid.Row="0" Background="Transparent">
                <!-- 左侧：图标 + 标题（不接收点击，保证空白处还能拖窗口）+ 批量编辑按钮
                     这里必须 Stretch（占满标题栏整高），不能只靠 Center：
                     左侧容器若只有内容那么高（22 DIP）再居中，起点是 7 DIP；右侧按钮组被
                     36 高的窗口按钮撑满、起点是 0。两边都算 7 DIP，但 UseLayoutRounding 在
                     0.5 DIP 处的舍入方向不同 → 150% DPI 下批量编辑图标比设置图标高 1 物理像素。 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                        <Image x:Name="AppIconImg" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="随记" Margin="10,0,0,0" FontSize="15"
                                   Foreground="#7E8F87" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnBatch" Style="{StaticResource TBtn}" ToolTip="批量编辑"
                            Margin="10,0,0,0" Width="22" Height="22"
                            VerticalContentAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnBatch_Click">
                        <!-- 清单式图标：左边三个勾、右边三条线 = 多选/批量。
                             Data 的 y 范围必须上下对称（2.8~13.2，中心 8.0）——不对称会让
                             图标自身重心偏高/偏低，22px 按钮里一眼就能看出「这个图标歪」。 -->
                        <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                              RenderTransform="1,0,0,1,0,1.5"
                              Data="M2.6,4.2 L3.9,5.5 L6.2,2.8 M8.6,4.2 H13.4 M2.6,8.2 L3.9,9.5 L6.2,6.8 M8.6,8.2 H13.4 M2.6,12.2 L3.9,13.5 L6.2,10.8 M8.6,12.2 H13.4"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- 批量编辑挪到左侧；回收站挪进设置面板 -->
                    <Button x:Name="BtnSettings" Style="{StaticResource TBtn}" ToolTip="设置"
                            Width="22" Height="22" VerticalContentAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnSettings_Click">
                        <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                              RenderTransform="1,0,0,1,0,1.5"
                              Data="M2.6,4.7 H4.7 M8.1,4.7 H13.4 M2.6,11.3 H7.9 M11.3,11.3 H13.4 M6.4,2.9 A1.8,1.8 0 1 0 6.4,6.5 A1.8,1.8 0 1 0 6.4,2.9 M9.6,9.5 A1.8,1.8 0 1 0 9.6,13.1 A1.8,1.8 0 1 0 9.6,9.5"/>
                    </Button>

                    <Border Width="1" Height="16" Background="#1AFFFFFF" Margin="4,0"/>
                    <Button Style="{StaticResource WBtn}" Click="BtnMin_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最小化">
                        <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="M3.5,8 H12.5"/>
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource WBtn}" Click="BtnMax_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最大化">
                        <Path x:Name="MaxIcon" Style="{StaticResource IconPath}" Width="12" Height="12"
                              Data="M3.6,3.6 H12.4 V12.4 H3.6 Z"/>
                    </Button>
                    <Button Style="{StaticResource WBtnClose}" Click="BtnClose_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭">
                        <Path Style="{StaticResource IconPath}" Width="12" Height="12"
                              Stroke="#AFC0B8" Data="M4,4 L12,12 M12,4 L4,12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 下面/左右各留 10 DIP：WebView2 是独立子窗口，会把「边框缩放」的命中整个吃掉。
                 让出这一圈后，边缘的 WM_NCHITTEST 才会回到 WPF 主窗口，才能拖边缩放。
                 留出来的地方露出的是窗口背景色（和网页底色同为 #060606），视觉上看不出来。 -->
            <wv2:WebView2 Grid.Row="1" x:Name="Web" DefaultBackgroundColor="#060606" Margin="6,0,3,6" />
        </Grid>
    </Border>
</Window>
